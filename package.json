{
  "name": "locus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first dashboard for personal social-media bookmarks and saves",
  "scripts": {
    "dev": "tsx scripts/build-extension.ts && node --experimental-sqlite --import tsx server/main.ts",
    "start": "NODE_ENV=production node --experimental-sqlite --import tsx server/main.ts",
    "build": "vite build && tsx scripts/build-extension.ts",
    "build:extension": "tsx scripts/build-extension.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "puppeteer-core": "^24.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
