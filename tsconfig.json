{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "app/src/**/*",
    "server/**/*",
    "core/**/*",
    "db/**/*",
    "packages/**/*",
    "runner/**/*",
    "site-packs/**/*",
    "importers/**/*",
    "optional/**/*",
    "tests/**/*"
  ]
}
